# blog-server 环境变量示例（复制为 .env 使用；.env 不入库）
# 示例中的域名一律用 example.com，请替换为你自己的地址。

# 管理端认证模式
#   builtin —— 默认。自带账号 + 登录页（开箱即用）
#   sso     —— 关掉自带口令，管理端身份交给你的前置认证（注入 X-Auth-User）
AUTH_MODE=builtin

# 服务监听端口（systemd 里显式设置为 4000）
PORT=4000

# JWT 签名密钥：生产必须显式设置，勿用默认 dev-secret
JWT_SECRET=dev-secret

# SQLite 数据库文件路径
DB_PATH=./data/blog.db

# Admin 会话 Redis（第二兼容通道）：支持逗号分隔多前缀（正式 + 测试）
ADMIN_REDIS_URL=redis://127.0.0.1:6379
ADMIN_REDIS_PREFIX=admin:session:

# 公共站点（博客前台）基址，含协议，取消末尾斜杠后使用。
# preview-link 用它拼绝对地址；未配置时回退相对路径并打 warn。
PUBLIC_SITE_URL=https://site.example.com

# 草稿预览链接有效期（jsonwebtoken 时长写法）
PREVIEW_TTL=30m

# 雪花 ID worker 号（仅多实例部署时需要区分）
SNOWFLAKE_WORKER_ID=0
